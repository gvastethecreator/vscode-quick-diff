{
  "name": "quick-diff",
  "displayName": "Quick Diff",
  "description": "Compare a selection, file, or clipboard in the native diff editor.",
  "version": "0.1.0",
  "packageManager": "pnpm@12.1.0",
  "publisher": "gvastethecreator",
  "author": {
    "name": "gvastethecreator"
  },
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "private": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#17191f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/vscode-quick-diff.git"
  },
  "bugs": {
    "url": "https://github.com/gvastethecreator/vscode-quick-diff/issues"
  },
  "homepage": "https://github.com/gvastethecreator/vscode-quick-diff#readme",
  "keywords": [
    "diff",
    "compare",
    "clipboard",
    "selection"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/node/extension.cjs",
  "browser": "./dist/web/extension.cjs",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "files": [
    "dist/node/extension.cjs",
    "dist/web/extension.cjs",
    "media/icon.png",
    "media/preview.png",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "quickDiff.compareSelectionWithClipboard",
        "title": "Compare Selection with Clipboard",
        "category": "Quick Diff",
        "enablement": "editorHasSelection"
      },
      {
        "command": "quickDiff.useSelectionAsLeft",
        "title": "Use Selection as Left Side",
        "category": "Quick Diff",
        "enablement": "editorHasSelection"
      },
      {
        "command": "quickDiff.compareSelectionWithLeft",
        "title": "Compare Selection with Left Side",
        "category": "Quick Diff",
        "enablement": "editorHasSelection"
      },
      {
        "command": "quickDiff.compareFileWithClipboard",
        "title": "Compare File with Clipboard",
        "category": "Quick Diff",
        "enablement": "editorTextFocus"
      },
      {
        "command": "quickDiff.compareOpenFiles",
        "title": "Compare Open Files...",
        "category": "Quick Diff"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "quickDiff.compareSelectionWithClipboard",
          "when": "editorTextFocus && editorHasSelection",
          "group": "1_modification@50"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && node esbuild.cjs",
    "watch": "node esbuild.cjs --watch",
    "package": "tsc --noEmit && node esbuild.cjs --production",
    "vsix": "vsce package --no-dependencies --out quick-diff.vsix",
    "inspect:vsix": "node scripts/inspect-vsix.mjs quick-diff.vsix",
    "check-types": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "node --test --experimental-strip-types src/**/*.test.ts",
    "test:performance": "node --experimental-strip-types scripts/performance.mjs",
    "test:integration": "node test/integration/run.mjs",
    "build:test-web": "node scripts/build-web-tests.mjs",
    "test:web": "pnpm run build:test-web && node test/web/run.mjs",
    "test:vsix": "node test/integration/run-vsix.mjs",
    "render:media": "node scripts/render-media.mjs",
    "check:media": "node scripts/check-media.mjs",
    "quality": "pnpm run test:unit && pnpm run check-types && pnpm run compile && pnpm run test:performance && pnpm run check:media"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@types/yauzl": "3.4.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "yauzl": "3.4.0"
  }
}
