{
  "name": "quick-diff",
  "displayName": "Quick Diff",
  "description": "Compare a selection, file, or clipboard in the native diff editor.",
  "version": "0.0.1",
  "packageManager": "pnpm@12.1.0",
  "publisher": "gvastethecreator",
  "author": {
    "name": "gvastethecreator"
  },
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/vscode-quick-diff.git"
  },
  "bugs": {
    "url": "https://github.com/gvastethecreator/vscode-quick-diff/issues"
  },
  "homepage": "https://github.com/gvastethecreator/vscode-quick-diff#readme",
  "keywords": [
    "diff",
    "compare",
    "clipboard",
    "selection"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "quickDiff.compareSelectionWithClipboard",
        "title": "Compare Selection with Clipboard",
        "category": "Quick Diff"
      },
      {
        "command": "quickDiff.useSelectionAsLeft",
        "title": "Use Selection as Left Side",
        "category": "Quick Diff"
      },
      {
        "command": "quickDiff.compareSelectionWithLeft",
        "title": "Compare Selection with Left Side",
        "category": "Quick Diff"
      },
      {
        "command": "quickDiff.compareFileWithClipboard",
        "title": "Compare File with Clipboard",
        "category": "Quick Diff"
      },
      {
        "command": "quickDiff.compareOpenFiles",
        "title": "Compare Open Files...",
        "category": "Quick Diff"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && node esbuild.cjs",
    "watch": "node esbuild.cjs --watch",
    "package": "tsc --noEmit && node esbuild.cjs --production",
    "vsix": "pnpm run package && vsce package --no-dependencies",
    "check-types": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
